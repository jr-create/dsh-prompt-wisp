{
  "name": "dsh-prompt-wisp",
  "version": "0.2.0",
  "description": "Prompt Wisp 提示词精灵 — 输入区一键优化提示词（简便/详细双模式）+ 会话执行监控（死锁/无效输出/工具循环告警），全部功能集中配置。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "homepage": "https://github.com/jr-create/dsh-prompt-wisp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jr-create/dsh-prompt-wisp.git"
  },
  "bugs": {
    "url": "https://github.com/jr-create/dsh-prompt-wisp/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./engine": "./lib/engine.js",
    "./http": "./lib/http.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-optimization",
    "composer",
    "chat",
    "cordis"
  ]
}
